е»" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="454" y="646" width="215" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>