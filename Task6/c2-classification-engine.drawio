<mxfile host="app.diagrams.net"><diagram id="C2-classification-engine" name="C2-classification-engine"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" pageWidth="1700" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="340" y="20" width="1120" height="720" as="geometry"/></mxCell><mxCell id="n3" value="Classification Engine [Container scope] — перед загрузкой в DWH" style="text;html=1;fontSize=13;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="360" y="690" width="600" height="30" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Источники&lt;/b&gt;&lt;br&gt;CRM / ЭМК / 1С / Excel,&lt;br&gt;схемы меняются" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;arcSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="300" width="180" height="100" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Ingestion&lt;/b&gt;&lt;br&gt;NiFi/Kafka: пулл батчей,&lt;br&gt;схема-agnostic (JSON)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;" vertex="1" parent="1"><mxGeometry x="340" y="300" width="200" height="110" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Профилировщик&lt;/b&gt;&lt;br&gt;статистика колонок, словари,&lt;br&gt;новые/изменившиеся поля" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;" vertex="1" parent="1"><mxGeometry x="600" y="100" width="210" height="120" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Детектор классов&lt;/b&gt;&lt;br&gt;regex/словари (СНИЛС, ФИО) + ML,&lt;br&gt;порог уверенности → ручная очередь" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;" vertex="1" parent="1"><mxGeometry x="600" y="300" width="210" height="120" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Очередь ревью&lt;/b&gt;&lt;br&gt;низкоуверенные кейсы →&lt;br&gt;владелец домена подтверждает" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;" vertex="1" parent="1"><mxGeometry x="600" y="520" width="210" height="100" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Тег-менеджер&lt;/b&gt;&lt;br&gt;теги PII/PHI/Financial/HR&lt;br&gt;в каталог (Apache Atlas)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;" vertex="1" parent="1"><mxGeometry x="880" y="300" width="200" height="110" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Policy engine&lt;/b&gt;&lt;br&gt;маскирование / токенизация /&lt;br&gt;пропуск по тегу" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;" vertex="1" parent="1"><mxGeometry x="880" y="520" width="200" height="100" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;DWH: слои&lt;/b&gt;&lt;br&gt;raw → sensitive (PHI, шифрование+доступ) → curated (обезличено) → gold" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1150" y="150" width="210" height="120" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Мониторинг/CI&lt;/b&gt;&lt;br&gt;метрики классификации,&lt;br&gt;отчёт в алертинг" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1150" y="480" width="210" height="110" as="geometry"/></mxCell><mxCell id="n13" value="батчи (структура меняется)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n14" value="сырые записи" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n15" value="поток на разметку" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n16" value="признаки колонок" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="confidence &amp;lt; порога" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=1;fontSize=10;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="подтверждённые классы" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=1;fontSize=10;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="авто-классы" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n20" value="данные + решения" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n5" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n21" value="теги → политика" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n22" value="маскирование/токенизация&lt;br&gt;перед загрузкой в слой" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="метаданные+lineage в каталог" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n9" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n24" value="метрики: precision/recall покрытия,&lt;br&gt;% нетегированных конфиденциальных" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n10" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n25" value="Устойчивость к смене схем:&lt;br&gt;• профилировщик ловит новые колонки → новый разметка;&lt;br&gt;• ML дообучается на ревью;&lt;br&gt;• теги хранятся в каталоге отдельно от схем.&lt;br&gt;&lt;br&gt;Метрики эффективности:&lt;br&gt;• покрытие полей тегами;&lt;br&gt;• точность/полнота против ревью-выборки;&lt;br&gt;• время от нового поля до тега;&lt;br&gt;• доля конфиденциальных данных, попавших в curated без маскирования (цель 0).&lt;br&gt;&lt;br&gt;Scalability: stateless-воркеры детектора масштабируются горизонтально (Kubernetes); батчи партиционируются по источникам; Kafka-очереди; каталог и policy — не узкое место." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FFF9E6;strokeColor=#E6D878;rounded=1;spacing=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="240" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>