<mxfile host="app.diagrams.net"><diagram id="C4-context-ToBe" name="C4-context-ToBe"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" pageWidth="1700" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="360" y="20" width="1150" height="700" as="geometry"/></mxCell><mxCell id="n3" value="Медикаменте [System] — To-Be MVP + Privacy by Design" style="text;html=1;fontSize=13;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="380" y="660" width="700" height="30" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Пациент&lt;/b&gt;&lt;br&gt;[Person]" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="80" y="300" width="180" height="90" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Врач&lt;/b&gt;&lt;br&gt;[Person]" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="80" y="480" width="180" height="90" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Ресепшен / кассир&lt;/b&gt;&lt;br&gt;[Person]" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="80" y="120" width="180" height="90" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Портал клиента + ЛК&lt;/b&gt;&lt;br&gt;[Container]&lt;br&gt;запись на приём, свои анализы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;" vertex="1" parent="1"><mxGeometry x="420" y="280" width="220" height="110" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Портал ресепшена&lt;/b&gt;&lt;br&gt;[Container]&lt;br&gt;журнал, напоминания" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;" vertex="1" parent="1"><mxGeometry x="420" y="80" width="220" height="110" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Сервис ЭМК&lt;/b&gt;&lt;br&gt;[Container]&lt;br&gt;медкарты, заключения" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;" vertex="1" parent="1"><mxGeometry x="420" y="480" width="220" height="110" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Keycloak (IAM)&lt;/b&gt;&lt;br&gt;OIDC/OAuth 2.0 + PKCE,&lt;br&gt;RBAC/ABAC, MFA сотрудников" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;" vertex="1" parent="1"><mxGeometry x="760" y="300" width="210" height="120" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;API-шлюз&lt;/b&gt;&lt;br&gt;контракты скрывают PHI,&lt;br&gt;scopes, rate limiting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;" vertex="1" parent="1"><mxGeometry x="760" y="60" width="210" height="110" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Аудит и алертинг&lt;/b&gt;&lt;br&gt;журнал доступа к PHI,&lt;br&gt;нетипичные действия → alerts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;" vertex="1" parent="1"><mxGeometry x="760" y="480" width="210" height="110" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;CRM (PostgreSQL)&lt;/b&gt;&lt;br&gt;теги PII/PHI, шифрование полей" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1080" y="280" width="230" height="110" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Платёжный шлюз&lt;/b&gt;&lt;br&gt;токенизация карт, чеки → 1С" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1080" y="80" width="230" height="110" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Аналитический слой&lt;br&gt;(Data Lake + BI/ML)&lt;/b&gt;&lt;br&gt;только обезличенные данные&lt;br&gt;(псевдонимизация/агрегаты)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1080" y="480" width="230" height="210" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;Лаборатория&lt;/b&gt;&lt;br&gt;[External System]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;arcSize=10;" vertex="1" parent="1"><mxGeometry x="420" y="640" width="200" height="80" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;1С:Бухгалтерия&lt;/b&gt;&lt;br&gt;[External System]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1080" y="640" width="200" height="80" as="geometry"/></mxCell><mxCell id="n18" value="HTTPS/TLS 1.3: запись, свои документы" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n4" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="HTTPS + MFA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n6" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n20" value="HTTPS; ABAC «только свои пациенты»" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n5" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n21" value="OIDC (PKCE): пациент видит только своё" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n7" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n22" value="OIDC + MFA, роли ресепшена/кассира" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n8" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="токены, роли врачей" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n24" value="запись [PII] — шифрование полей" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n7" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n25" value="журнал, напоминания (робот/пуш)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n8" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n26" value="пациент (мастер-запись)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n9" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" value="оплата: токен карты, без хранения PAN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n7" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n28" value="mTLS + OAuth scopes: только свои направления" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n16" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n29" value="результаты анализов [PHI]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n11" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n30" value="события доступа к PHI (кто/что/когда)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n9" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n31" value="доступы к PII" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n13" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n32" value="ETL: обезличивание (псевдонимы, k-анонимность)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n13" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n33" value="выгрузка признаков без идентификаторов" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n9" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n34" value="чеки/проводки по API (без ПДн карт)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n14" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n35" value="Принципы PbD (где реализованы):&lt;br&gt;1. Проактивность: аудит+алерты до инцидента (Аудит); PIA на новые потоки.&lt;br&gt;2. Privacy by default: в контрактах API конфиденциальные категории скрыты (API-шлюз); минимизация сбора на портале.&lt;br&gt;3. Встроено в дизайн: теги PII/PHI в CRM/ЭМК; шифрование полей; ABAC лечащего врача.&lt;br&gt;4. Positive-sum: удобный ЛК пациента И защита (свои данные — по sub из токена).&lt;br&gt;5. End-to-end: TLS 1.3 everywhere + AES-256 at rest + токенизация.&lt;br&gt;6. Прозрачность: журнал доступа, панель «мои данные и согласия» в ЛК.&lt;br&gt;7. Уважение к пользователю: согласия и отзыв (152-ФЗ), сроки хранения/удаления.&lt;br&gt;&lt;br&gt;Аналитический слой: BI/ML/AI работают ТОЛЬКО на обезличенных копиях — сырые PHI не покидают операционный контур." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FFF9E6;strokeColor=#E6D878;rounded=1;spacing=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1380" y="60" width="290" height="400" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>