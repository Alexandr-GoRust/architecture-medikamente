<mxfile host="app.diagrams.net"><diagram id="As-Is" name="As-Is"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" pageWidth="1400" pageHeight="760"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;Пациент&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="130" height="70" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;4. Направление на анализы&lt;/b&gt;&lt;br&gt;(ресепшен)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="310" y="280" width="190" height="100" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Outlook&lt;/b&gt;&lt;br&gt;пересылка направлений" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="610" y="180" width="200" height="90" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Лаборатория&lt;/b&gt;&lt;br&gt;[внешний субъект]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="610" y="380" width="200" height="80" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Результаты&lt;/b&gt;&lt;br&gt;Excel/скан → общий диск" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="310" y="540" width="190" height="80" as="geometry"/></mxCell><mxCell id="n7" value="🛡 Ф.И.О., паспортные данные" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.5;dashed=0;fontSize=10;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n8" value="🛡 направление с ПДн (e-mail)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.5;dashed=0;fontSize=10;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n9" value="🛡 наружу, без шифрования" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.5;dashed=0;fontSize=10;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n10" value="🛡 результаты (e-mail/файл)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.5;dashed=0;fontSize=10;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n11" value="Проблемы: медданные уходят по почте наружу без контроля и шифрования (П4);&lt;br&gt;нет контракта API — каждый обмен перевалидируется вручную; ПДн у третьего лица без соглашения" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FFF9E6;strokeColor=#E6D878;rounded=1;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="440" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="To-Be" name="To-Be"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" pageWidth="1400" pageHeight="760"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;Пациент&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="130" height="70" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;4&#x27;. Направление&lt;/b&gt;&lt;br&gt;в CRM" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="300" y="280" width="190" height="100" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;API-шлюз лаборатории&lt;/b&gt;&lt;br&gt;OAuth 2.0 scopes; контракт скрывает PHI" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="590" y="280" width="220" height="110" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Лаборатория&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="590" y="480" width="200" height="80" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;ЛК пациента&lt;/b&gt;: свои результаты" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="300" y="540" width="200" height="80" as="geometry"/></mxCell><mxCell id="n7" value="минимум ПДн для направления" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=1.5;dashed=0;fontSize=10;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n8" value="TLS 1.3 + mTLS; идентификатор = токен (псевдонимизация)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=1.5;dashed=0;fontSize=10;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n9" value="scope: только свои направления;&lt;br&gt;пациент №2 не видит пациента №1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=1.5;dashed=0;fontSize=10;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n10" value="результаты [PHI] → ЭМК, доступ по sub" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=1.5;dashed=0;fontSize=10;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n11" value="To-Be: обмен только через API-шлюз (почта исключена), данные по умолчанию закрыты —&lt;br&gt;новые партнёрские интеграции подключаются без перевалидации всего потока" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FFF9E6;strokeColor=#E6D878;rounded=1;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="460" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>