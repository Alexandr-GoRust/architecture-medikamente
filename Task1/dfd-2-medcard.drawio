<mxfile host="app.diagrams.net"><diagram id="As-Is" name="As-Is"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" pageWidth="1400" pageHeight="760"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;Пациент&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="130" height="70" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;2. Приём врача&lt;/b&gt;&lt;br&gt;(заполнение карты)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="320" y="280" width="200" height="110" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Медкарта: Excel/JPG/PDF&lt;br&gt;на общем диске&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="660" y="280" width="220" height="90" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Общий диск&lt;/b&gt; — доступ всей&lt;br&gt;доменной группе" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="660" y="480" width="220" height="80" as="geometry"/></mxCell><mxCell id="n6" value="🛡 жалобы, анамнез" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.5;dashed=0;fontSize=10;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n7" value="🛡 диагноз, назначения (файл)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.5;dashed=0;fontSize=10;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n8" value="тот же диск: копии без контроля" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.5;dashed=1;fontSize=10;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n9" value="Проблемы: спец. категория ПДн (здоровье) без шифрования и аудита (П1,П2,П3);&lt;br&gt;«доступ у всех с учёткой» — нет наименьших привилегий (П10)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FFF9E6;strokeColor=#E6D878;rounded=1;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="400" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="To-Be" name="To-Be"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" pageWidth="1400" pageHeight="760"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;Пациент&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="130" height="70" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;2&#x27;. ЭМК-сервис&lt;/b&gt;&lt;br&gt;(электронная медкарта)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="300" y="280" width="190" height="110" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;БД ЭМК (PostgreSQL)&lt;/b&gt;&lt;br&gt;[тег PHI] поля AES-256, аудит" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="620" y="280" width="240" height="100" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;S3 (SSE) сканы&lt;/b&gt;&lt;br&gt;заключений" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="620" y="480" width="240" height="90" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;ЛК пациента&lt;/b&gt;: только свои анализы/заключения" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="300" y="530" width="190" height="70" as="geometry"/></mxCell><mxCell id="n7" value="TLS: приём" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=1.5;dashed=0;fontSize=10;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n8" value="[тег PHI] диагноз; ABAC «только лечащий врач»;&lt;br&gt;журнал каждого чтения карты" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=1.5;dashed=0;fontSize=10;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n9" value="[PHI] скан заключения, шифрование" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=1.5;dashed=0;fontSize=10;" edge="1" parent="1" source="n3" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n10" value="OIDC: sub пациента → свои документы;&lt;br&gt;чужие → 403" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=1.5;dashed=0;fontSize=10;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n11" value="To-Be: доступ к PHI — по атрибутам (лечащий врач), каждое обращение в аудите,&lt;br&gt;аномалии (массовые выгрузки) → алерты; копий на общем диске нет" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FFF9E6;strokeColor=#E6D878;rounded=1;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="430" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>