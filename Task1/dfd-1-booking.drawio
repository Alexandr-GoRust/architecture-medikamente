<mxfile host="app.diagrams.net"><diagram id="As-Is" name="As-Is"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" pageWidth="1400" pageHeight="760"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;Пациент&lt;/b&gt;&lt;br&gt;[внешний субъект]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="140" height="70" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;1. Запись на приём&lt;/b&gt;&lt;br&gt;(ресепшен, вручную)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="330" y="280" width="190" height="110" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Журнал записей&lt;br&gt;(Excel)&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="640" y="150" width="210" height="80" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Общий диск&lt;/b&gt;&lt;br&gt;(контракты, анкеты)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="640" y="380" width="210" height="80" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Outlook&lt;/b&gt;&lt;br&gt;(напоминания)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="330" y="520" width="190" height="70" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Врач&lt;/b&gt;&lt;br&gt;[субъект]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="680" y="560" width="140" height="70" as="geometry"/></mxCell><mxCell id="n8" value="🛡 Ф.И.О., телефон, причина визита" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.5;dashed=0;fontSize=10;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n9" value="внести запись" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.5;dashed=0;fontSize=10;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n10" value="🛡 анкета/контракт (скан)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.5;dashed=0;fontSize=10;" edge="1" parent="1" source="n3" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n11" value="🛡 расписание врачу/пациенту" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.5;dashed=0;fontSize=10;" edge="1" parent="1" source="n3" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n12" value="🛡 e-mail с ПДн" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.5;dashed=0;fontSize=10;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n13" value="Проблемы: ПДн в Excel без шифрования и аудита (П1,П3);&lt;br&gt;сбор избыточных данных анкеты (П9); почта как канал ПДн (П4)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FFF9E6;strokeColor=#E6D878;rounded=1;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="330" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="To-Be" name="To-Be"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" pageWidth="1400" pageHeight="760"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;Пациент&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="140" height="70" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;1&#x27;. Портал записи / ЛК&lt;/b&gt;&lt;br&gt;+ мобильное приложение" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="320" y="270" width="200" height="120" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;CRM (PostgreSQL)&lt;/b&gt;&lt;br&gt;теги PII; шифрование полей" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="640" y="270" width="210" height="110" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Keycloak (OIDC)&lt;/b&gt;: аутентификация, RBAC/ABAC" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="320" y="520" width="200" height="80" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Портал ресепшена&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="680" y="540" width="170" height="70" as="geometry"/></mxCell><mxCell id="n7" value="TLS 1.3: только Ф.И.О., телефон, врач, слот&lt;br&gt;(минимизация: без причины визита)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=1.5;dashed=0;fontSize=10;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n8" value="[тег PII] запись → шифрование полей AES-256" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=1.5;dashed=0;fontSize=10;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n9" value="OAuth 2.0 (PKCE) — пациент видит только свои данные" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=1.5;dashed=0;fontSize=10;" edge="1" parent="1" source="n3" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n10" value="[RBAC] ресепшен видит запись;&lt;br&gt;напоминание за день (робот/пуш)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=1.5;dashed=0;fontSize=10;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n11" value="To-Be: ПДн только в CRM (единый источник), шифрование at rest,&lt;br&gt;доступ по ролям, аудит обращений, согласие зафиксировано" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FFF9E6;strokeColor=#E6D878;rounded=1;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="420" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>